MA_URL=http://your-music-assistant-host:8095
MA_TOKEN=your-music-assistant-long-lived-token

# JSON object: playlist name -> list of Music Assistant library playlist
# item_ids to union together. A name can list more than one id to compose
# playlists (e.g. a "teens" catalog that also includes everything in "kids",
# without hand-duplicating entries in Music Assistant itself).
PLAYLIST_SOURCES_JSON={"kids": ["10"], "teens": ["10", "11"]}

# Only needed for the "resume" intent on /v1/assist (the v2 blueprint).
# Music Assistant's own last-played ordering has been reported unreliable
# for Audiobookshelf-backed libraries, so resume asks Audiobookshelf
# directly instead. Leave unset if you're not using Audiobookshelf, or
# don't need "resume my audiobook" — search and list still work without it.
ABS_URL=http://your-audiobookshelf-host:13378
ABS_TOKEN=your-audiobookshelf-api-token
# Find this in Music Assistant: open any Audiobookshelf-provided audiobook,
# scroll to "Provider details" — the instance id is embedded in the item's
# provider link/URI shown there.
ABS_INSTANCE_ID=your-audiobookshelf-provider-instance-id

# Off by default. When on, the service also fetches your whole Music
# Assistant music library (tracks, from whatever music providers you have
# configured — Apple Music, Spotify, etc.) at startup, and falls back to
# searching it for "play X" requests that don't look like a book request
# and didn't match the book catalog (e.g. "play Taylor Swift"). Verify
# fetch_music_tracks() against your own MA instance before enabling — see
# the note in ma_client.py.
MUSIC_ENABLED=false
